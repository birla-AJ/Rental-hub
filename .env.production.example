# Copy to .env.production and fill in. NEVER commit the real file.
DOMAIN=app.your-domain.in
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# API (apps/api)
JWT_SECRET=paste-at-least-32-random-characters        # e.g.  openssl rand -base64 48
CORS_ORIGINS=https://app.your-domain.in
SMS_PROVIDER=msg91
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_VAR=OTP
# WhatsApp (optional until Meta approves your templates)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=choose-any-string

# First start only: this person becomes the first admin and signs in with an SMS code. After that, add staff in the admin site (Staff page).
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_NAME=Your Name
# Never set SEED_DEMO=1 on a live server (it adds fake demo users and properties).

# Payments (REQUIRED in production). Razorpay dashboard -> Settings -> API Keys, and Webhooks.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
