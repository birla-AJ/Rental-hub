# RentalHub API. Build from the repo root:  docker build -f Dockerfile.api -t rentalhub-api .
FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY packages/core ./packages/core
COPY apps/api/package.json ./apps/api/package.json
WORKDIR /app/apps/api
RUN npm install --omit=dev --include=optional && npm cache clean --force
COPY apps/api/src ./src
RUN mkdir -p /data/uploads /data/private && chown -R node:node /data
ENV UPLOAD_DIR=/data/uploads PORT=4000
USER node
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD node -e "fetch('http://localhost:4000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "src/server.js"]
