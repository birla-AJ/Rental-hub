// RentalHub database schema (PostgreSQL)
// Single Source of Truth for RentalHub Production Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TENANT
  OWNER
  AGENT
  ADMIN
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

enum PropertyStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFICATION_IN_PROGRESS
  VERIFIED
  REJECTED
  OCCUPIED
  VACANT
  PLACEMENT_IN_PROGRESS
  PLACED
  INACTIVE
}

enum AgentTask {
  PENDING
  VERIFIED
  REJECTED
  REVISIT
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  CHECKOUT_REQUESTED
  VERIFICATION_PENDING
  VACANT
  PLACEMENT_IN_PROGRESS
  BOOKED
  RESERVED
}

enum TokenState {
  LOCKED
  DORMANT
  ELIGIBLE
  REDEEMED
  CANCELLED
  UNDER_REVIEW
}

enum CheckoutState {
  INITIATED
  QR_SCANNED
  AWAITING_PARTIES
  VERIFIED
  DISPUTED
  MANUAL_REVIEW
  REJECTED
}

enum CommissionStatus {
  DUE
  PAID
  WAIVED
}

enum BookingStatus {
  REQUESTED
  PENDING
  CONFIRMED
  MOVED_IN
  REJECTED
  CANCELLED
}

enum QrStatus {
  ACTIVE
  REVOKED
}

model City {
  id         String     @id @default(cuid())
  name       String     @unique
  active     Boolean    @default(true)
  users      User[]
  properties Property[]
}

model User {
  id            String      @id @default(cuid())
  phone         String      @unique
  email         String?     @unique
  name          String
  passwordHash  String?
  passwordSalt  String?
  role          Role        @default(TENANT)
  roles         Role[]      @default([TENANT])
  kycStatus     KycStatus   @default(NOT_STARTED)
  cityId        String?
  city          City?       @relation(fields: [cityId], references: [id], onDelete: SetNull)
  disabled      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  kycRecords        KycRecord[]
  registeredProps   Property[]     @relation("PropertyRegisteredBy")
  ownedProps        Property[]     @relation("PropertyOwner")
  agentProps        Property[]     @relation("PropertyAgent")
  tenancies         Tenancy[]
  tokens            CashbackToken[]
  bookings          Booking[]
  commissions       Commission[]
  checkoutsAsTenant Checkout[]     @relation("CheckoutTenant")
  checkoutsAsOwner  Checkout[]     @relation("CheckoutOwner")
  auditLogs         AuditLog[]
  notifications     Notification[]
  rooms             Room[]         @relation("RoomOwner")
  deviceTokens      DeviceToken[]
  savedRooms        SavedRoom[]
  privateFiles      PrivateFile[]

  @@index([phone])
  @@index([email])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())

  @@index([userId])
}

model SavedRoom {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roomId])
  @@index([userId])
}

model PrivateFile {
  id        String   @id
  ownerId   String
  user      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind      String   @default("kyc")
  ext       String
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model KycRecord {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  idType     String
  status     KycStatus
  fullName   String?
  dob        String?
  docRef     String?
  verifiedBy String?
  note       String?
  reason     String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Property {
  id              String         @id @default(cuid())
  name            String
  address         String
  locality        String
  type            String?        @default("PG")
  cityId          String?
  city            City?          @relation(fields: [cityId], references: [id], onDelete: SetNull)
  status          PropertyStatus @default(PENDING_VERIFICATION)
  agentTask       AgentTask      @default(PENDING)
  registeredById  String
  registeredBy    User           @relation("PropertyRegisteredBy", fields: [registeredById], references: [id], onDelete: Cascade)
  ownerId         String?
  owner           User?          @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerName       String
  ownerPhone      String
  ownerConsentAt  DateTime?
  ownerDeclinedAt DateTime?
  agentId         String?
  agent           User?          @relation("PropertyAgent", fields: [agentId], references: [id], onDelete: SetNull)
  visit           String?
  visitAt         DateTime?
  startedAt       DateTime?
  geoLat          Float?
  geoLng          Float?
  geoAccuracyM    Int?
  verifiedAt      DateTime?
  agentNote       String?
  photos          String[]       @default([])
  video           String?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  rooms           Room[]
  tokens          CashbackToken[]

  @@index([cityId, status])
  @@index([agentId, agentTask])
  @@index([registeredById])
  @@index([ownerId])
}

model Room {
  id             String          @id @default(cuid())
  propertyId     String
  property       Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name           String
  roomType       String?         @default("Room")
  rent           Int
  beds           Int?            @default(1)
  baths          Int?            @default(1)
  furnished      String?         @default("UNFURNISHED")
  amenities      String[]        @default([])
  status         RoomStatus      @default(AVAILABLE)
  ownerId        String?
  owner          User?           @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tenantId       String?
  formerTenantId String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  qr             QrTag?
  tenancies      Tenancy[]
  checkouts      Checkout[]
  windows        VacancyWindow[]
  commissions    Commission[]
  tokens         CashbackToken[]
  bookings       Booking[]
  savedBy        SavedRoom[]

  @@index([propertyId, status])
  @@index([ownerId])
  @@index([tenantId])
}

model QrTag {
  id         String    @id @default(cuid())
  roomId     String    @unique
  room       Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  code       String    @unique
  status     QrStatus  @default(ACTIVE)
  assignedAt DateTime  @default(now())
}

model Tenancy {
  id        String    @id @default(cuid())
  roomId    String
  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    User      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  startedAt DateTime
  endedAt   DateTime?

  @@index([tenantId])
  @@index([roomId])
}

model CashbackToken {
  id                    String        @id @default(cuid())
  tenantId              String
  tenant                User          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId            String
  property              Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomId                String
  room                  Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  amount                Int
  state                 TokenState    @default(DORMANT)
  eligibleAt            DateTime?
  redeemedAt            DateTime?
  reservedBy            String?
  inactivityTrackedFrom DateTime      @default(now())
  createdAt             DateTime      @default(now())
  txns                  CashbackTxn[]

  @@index([tenantId, state])
}

model CashbackTxn {
  id            String        @id @default(cuid())
  tokenId       String
  token         CashbackToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  bookingNumber Int
  credit        Int
  createdAt     DateTime      @default(now())

  @@index([tokenId])
}

model Checkout {
  id             String          @id @default(cuid())
  roomId         String
  room           Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tenantId       String
  tenant         User            @relation("CheckoutTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId        String
  owner          User            @relation("CheckoutOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  state          CheckoutState   @default(INITIATED)
  qrScannedAt    DateTime?
  tenantDate     DateTime?
  ownerDate      DateTime?
  ownerConfirmed Boolean?
  verifiedAt     DateTime?
  log            Json?
  createdAt      DateTime        @default(now())
  events         CheckoutEvent[]

  @@index([roomId, state])
}

model CheckoutEvent {
  id         String   @id @default(cuid())
  checkoutId String
  checkout   Checkout @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  event      String
  channel    String?
  detail     String?
  at         DateTime @default(now())

  @@index([checkoutId])
}

model VacancyWindow {
  id                String    @id @default(cuid())
  roomId            String
  room              Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  startedAt         DateTime
  endsAt            DateTime
  closedAt          DateTime?
  continuePlacement Boolean   @default(false)

  @@index([roomId])
}

model Commission {
  id          String           @id @default(cuid())
  roomId      String
  room        Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookingId   String?
  newTenantId String?
  days        Float?
  status      CommissionStatus
  amount      Int              @default(0)
  waivedValue Int              @default(0)
  paidAt      DateTime?
  createdAt   DateTime         @default(now())

  @@index([ownerId, status])
}

model Booking {
  id              String        @id @default(cuid())
  roomId          String
  room            Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          User          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status          BookingStatus @default(REQUESTED)
  moveInDate      DateTime
  months          Int
  bookingNumber   Int
  cashbackApplied Int           @default(0)
  quote           Json?
  history         Json?
  payment         Json?
  order           Json?
  refund          Json?
  placement       Json?
  reason          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([tenantId])
  @@index([roomId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    @default("SYSTEM")
  title     String
  body      String
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, read])
}

model AuditLog {
  id       String   @id @default(cuid())
  userId   String?
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  role     Role?
  action   String
  entity   String?
  entityId String?
  at       DateTime @default(now())

  @@index([at])
}
