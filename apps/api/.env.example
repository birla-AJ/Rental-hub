# --- Storage: pick ONE (if neither is set the API keeps data in memory only; production refuses to start) ---
SQLITE_PATH="./data/rentalhub.db"                 # single-server pilot. Uploads are stored next to it in ./data/uploads
# DATABASE_URL="postgresql://rentalhub:rentalhub@localhost:5432/rentalhub"   # PostgreSQL (run `npm i pg` first; `docker compose up -d` starts one)

JWT_SECRET="replace-with-a-long-random-string"   # REQUIRED in production
NODE_ENV="development"                           # production: OTP never returned in API responses; durable storage required
PORT=4000

# --- WhatsApp (optional; without these the assistant uses a recording mock and sends nothing) ---
# WHATSAPP_TOKEN="..."            # Meta WhatsApp Cloud API access token
# WHATSAPP_PHONE_ID="..."         # sender phone-number id
# WHATSAPP_APP_SECRET="..."       # signs inbound webhooks (REQUIRED in production)
# WHATSAPP_VERIFY_TOKEN="..."     # any string you choose; paste the same into Meta's webhook setup
# Webhook URL to register in Meta: https://<your-domain>/webhooks/whatsapp

# --- SMS for OTP login (REQUIRED in production; without it a mock records codes and sends nothing) ---
# SMS_PROVIDER="msg91"
# MSG91_AUTHKEY="..."
# MSG91_TEMPLATE_ID="..."         # your DLT-approved OTP template
# MSG91_OTP_VAR="OTP"             # the variable name used inside that template
# TRUST_PROXY=1                   # set only behind a reverse proxy you control (uses X-Forwarded-For for per-IP limits)
