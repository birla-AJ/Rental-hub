{
  "name": "@rentalhub/api",
  "version": "0.1.0",
  "type": "module",
  "main": "src/server.js",
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "pg": "^8.11.0",
    "prisma": "^5.20.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "check:env": "node -e \"import('./src/hardening.js').then(({validateEnv})=>{const r=validateEnv();r.warnings.forEach(w=>console.log('warning:',w));if(r.errors.length){r.errors.forEach(e=>console.log('ERROR:',e));process.exit(1)}console.log('Environment looks good.')})\""
  }
}